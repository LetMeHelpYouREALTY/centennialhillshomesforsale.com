# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Next.js Environment
NODE_ENV=development

# Site Configuration (must match canonical host; production uses www — see next.config.js redirects)
NEXT_PUBLIC_SITE_URL=https://www.heyberkshire.com

# Google Search Console — HTML tag verification content only (not the full meta tag)
# https://search.google.com/search-console
GOOGLE_SITE_VERIFICATION=
