# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Next.js Environment
NODE_ENV=development

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://heyberkshire.com

# Cloudflare Images (optional CDN). Git copies in public/images are the backup.
# Upload with: node scripts/upload-cloudflare-images.mjs
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# NEXT_PUBLIC_CLOUDFLARE_IMAGES_ENABLED=true
# NEXT_PUBLIC_CLOUDFLARE_ACCOUNT_HASH=
